{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-inspector.invalid/contracts/project-2.0.schema.json",
  "title": "System Inspector project configuration v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "display_timezone": {
          "const": "UTC"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "revision",
        "display_timezone"
      ],
      "additionalProperties": false
    },
    "subsystems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "description": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 0,
            "maxItems": 100
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "tags"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "credential_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "jump_connection_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "allowed_log_roots": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 4096,
              "pattern": "^/[^\\u0000\\r\\n]*$"
            },
            "minItems": 0,
            "maxItems": 20
          }
        },
        "required": [
          "id",
          "name",
          "host",
          "port",
          "username",
          "credential_ref",
          "jump_connection_id",
          "allowed_log_roots"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "servers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "subsystem_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "connection_id": {
            "type": ["string", "null"],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "description": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 0,
            "maxItems": 100
          }
        },
        "required": [
          "id",
          "name",
          "subsystem_id",
          "connection_id",
          "description",
          "tags"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "server_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "pcs_resource_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 0,
            "maxItems": 100
          },
          "log_source": {
            "type": "object",
            "properties": {
              "active_path": {
                "type": "string",
                "minLength": 2,
                "maxLength": 4096,
                "pattern": "^/[^\\u0000\\r\\n]*$"
              },
              "rotated_patterns": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 4096,
                  "pattern": "^/[^\\u0000\\r\\n]*$"
                },
                "minItems": 0,
                "maxItems": 20
              },
              "archives": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path_pattern": {
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 4096,
                      "pattern": "^/[^\\u0000\\r\\n]*$"
                    },
                    "member_patterns": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "minItems": 1,
                      "maxItems": 20
                    }
                  },
                  "required": [
                    "path_pattern",
                    "member_patterns"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 20
              },
              "parser_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "encoding": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "allow_symlink": {
                "type": "boolean"
              }
            },
            "required": [
              "active_path",
              "rotated_patterns",
              "archives",
              "parser_id",
              "encoding",
              "allow_symlink"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "server_id",
          "pcs_resource_name",
          "description",
          "tags",
          "log_source"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "parsers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "timestamp": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "iso8601_prefix"
                  },
                  "naive_timezone": {
                    "const": "UTC"
                  }
                },
                "required": [
                  "kind",
                  "naive_timezone"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "fixed_width"
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "format": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "naive_timezone": {
                    "const": "UTC"
                  }
                },
                "required": [
                  "kind",
                  "width",
                  "format",
                  "naive_timezone"
                ],
                "additionalProperties": false
              }
            ]
          },
          "correlation_markers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "prefix": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "terminators": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                }
              },
              "required": [
                "key",
                "prefix",
                "terminators"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 20
          }
        },
        "required": [
          "id",
          "name",
          "timestamp",
          "correlation_markers"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "source_process_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "target_process_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "protocol": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "source_process_id",
          "target_process_id",
          "protocol",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "element_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "collapsed": {
                  "type": "boolean"
                }
              },
              "required": [
                "element_id",
                "x",
                "y",
                "width",
                "height",
                "collapsed"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "flow_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "name",
          "nodes",
          "flow_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "settings": {
      "type": "object",
      "properties": {
        "ui": {
          "type": "object",
          "properties": {
            "product_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "locale": {
              "const": "en"
            }
          },
          "required": [
            "product_name",
            "locale"
          ],
          "additionalProperties": false
        },
        "live": {
          "type": "object",
          "properties": {
            "poll_interval_ms": {
              "type": "integer",
              "minimum": 250,
              "maximum": 5000
            },
            "reorder_buffer_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2000
            },
            "record_by_default": {
              "type": "boolean"
            }
          },
          "required": [
            "poll_interval_ms",
            "reorder_buffer_ms",
            "record_by_default"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ui",
        "live"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "project",
    "subsystems",
    "connections",
    "servers",
    "processes",
    "parsers",
    "flows",
    "views",
    "settings"
  ],
  "additionalProperties": false
}
