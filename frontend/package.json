{
  "name": "system-inspector-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.22.0 <25", "npm": ">=11.19.1 <12" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run api:check && node --experimental-strip-types --test tests/*.test.mjs",
    "e2e": "playwright test",
    "api:generate": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts",
    "api:check": "node scripts/check-api-types.mjs",
    "notices": "node scripts/collect-notices.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.21",
    "@xyflow/react": "12.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  }
}
