[mariadbd]
character-set-server=utf8mb4
collation-server=utf8mb4_bin
default-time-zone=+00:00
local-infile=0
skip-name-resolve
max-connections=50
innodb-buffer-pool-size=256M
# Application and migration accounts receive no global FILE privilege.
# MariaDB does not support MySQL's secure-file-priv=NULL disable syntax.
