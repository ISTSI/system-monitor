{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Own appearance and language preference response",
  "type": "object",
  "properties": {
    "language": {
      "enum": ["default", "en", "pl"]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "theme_mode": {
      "enum": [
        "default",
        "light",
        "dark",
        "system"
      ]
    }
  },
  "required": [
    "revision",
    "theme_mode",
    "language"
  ],
  "additionalProperties": false
}
