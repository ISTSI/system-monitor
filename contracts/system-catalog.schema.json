{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:system-inspector:system-catalog:1",
  "title": "Named system catalogue, safe viewer projection",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "description": {
            "type": "string",
            "maxLength": 10000
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "archived": {
            "type": "boolean"
          },
          "own_live_sessions": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "project_id",
          "name",
          "description",
          "revision",
          "archived",
          "own_live_sessions"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
