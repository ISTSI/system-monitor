{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:system-inspector:inventory-import:1",
  "title": "System-scoped inventory preview request (uploaded data only)",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "inventory_source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "upload_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    },
    "format": {
      "enum": [
        "ini",
        "yaml",
        "canonical_json",
        "static_zip"
      ]
    },
    "source_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000\\r\\n]+$"
      },
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true
    },
    "mapping": {
      "type": "object",
      "properties": {
        "group_to_subsystem": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "maxProperties": 1000
        },
        "host_to_subsystem": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "maxProperties": 1000
        },
        "tag_only_groups": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 0,
          "maxItems": 200,
          "uniqueItems": true
        },
        "credential_mapping": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "maxProperties": 1000
        },
        "jump_mapping": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxProperties": 1000
        },
        "parser_mapping": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "maxProperties": 1000
        },
        "preserve_existing_documentation": {
          "const": true
        },
        "preserve_existing_layout": {
          "const": true
        },
        "delete_missing_hosts": {
          "const": false
        }
      },
      "required": [
        "group_to_subsystem",
        "host_to_subsystem",
        "tag_only_groups",
        "credential_mapping",
        "jump_mapping",
        "parser_mapping",
        "preserve_existing_documentation",
        "preserve_existing_layout",
        "delete_missing_hosts"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "project_id",
    "inventory_source_id",
    "upload_id",
    "expected_revision",
    "format",
    "source_files",
    "mapping"
  ],
  "additionalProperties": false
}
