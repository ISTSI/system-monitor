{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:system-inspector:workspace:1",
  "title": "Server-owned browser workspace response",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "owner_user_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "active",
        "detached",
        "expired"
      ]
    },
    "live_session_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 0,
      "maxItems": 200,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "workspace_id",
    "project_id",
    "owner_user_id",
    "revision",
    "state",
    "live_session_ids"
  ],
  "additionalProperties": false
}
