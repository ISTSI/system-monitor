{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:system-inspector:live-request:2",
  "title": "Create project/workspace-scoped live session request",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "project_revision": {
      "type": "integer",
      "minimum": 1
    },
    "process_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true
    },
    "mode": {
      "enum": [
        "merged",
        "split"
      ]
    },
    "seed_rows": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "seed_rows_by_process": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500
      }
    },
    "filter": {
      "type": "object",
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 512
          },
          "minItems": 0,
          "maxItems": 20
        },
        "include_mode": {
          "enum": [
            "any",
            "all"
          ]
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 512
          },
          "minItems": 0,
          "maxItems": 20
        },
        "case_sensitive": {
          "type": "boolean"
        }
      },
      "required": [
        "include",
        "include_mode",
        "exclude",
        "case_sensitive"
      ],
      "additionalProperties": false
    },
    "per_process_filters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "include": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 512
            },
            "minItems": 0,
            "maxItems": 20
          },
          "include_mode": {
            "enum": [
              "any",
              "all"
            ]
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 512
            },
            "minItems": 0,
            "maxItems": 20
          },
          "case_sensitive": {
            "type": "boolean"
          }
        },
        "required": [
          "include",
          "include_mode",
          "exclude",
          "case_sensitive"
        ],
        "additionalProperties": false
      }
    },
    "record": {
      "type": "boolean"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    }
  },
  "required": [
    "project_id",
    "project_revision",
    "process_ids",
    "mode",
    "seed_rows",
    "seed_rows_by_process",
    "filter",
    "per_process_filters",
    "record",
    "workspace_id"
  ],
  "additionalProperties": false
}
