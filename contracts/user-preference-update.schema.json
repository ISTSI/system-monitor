{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Own appearance and language preference partial update request",
  "type": "object",
  "properties": {
    "language": {
      "enum": ["default", "en", "pl"]
    },
    "theme_mode": {
      "enum": [
        "default",
        "light",
        "dark",
        "system"
      ]
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": ["expected_revision"],
  "anyOf": [
    {"required": ["theme_mode"]},
    {"required": ["language"]}
  ],
  "additionalProperties": false
}
