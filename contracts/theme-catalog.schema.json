{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theme reference catalog",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "default_mode": {
      "enum": [
        "light",
        "dark"
      ]
    },
    "themes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "mode": {
            "enum": [
              "light",
              "dark"
            ]
          },
          "name": {
            "type": "string"
          },
          "reference_asset": {
            "type": "string"
          },
          "tokens": {
            "type": "object",
            "properties": {
              "canvas": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "surface": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "raised": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "header": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "log_background": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "input_background": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "text": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "text_muted": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "border": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "control_border": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "accent": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "selection_background": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "selection_border": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "focus": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "flow": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "success": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "warning": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "danger": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "unknown": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "match_background": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "match_text": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              }
            },
            "required": [
              "canvas",
              "surface",
              "raised",
              "header",
              "log_background",
              "input_background",
              "text",
              "text_muted",
              "border",
              "control_border",
              "accent",
              "selection_background",
              "selection_border",
              "focus",
              "flow",
              "success",
              "warning",
              "danger",
              "unknown",
              "match_background",
              "match_text"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "mode",
          "name",
          "reference_asset",
          "tokens"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "default_mode",
    "themes"
  ],
  "additionalProperties": false
}
