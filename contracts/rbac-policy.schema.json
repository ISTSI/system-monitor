{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Application permission contract",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "roles": {
      "const": [
        "administrator",
        "inspector"
      ]
    },
    "default_deny": {
      "const": true
    },
    "actions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "administrator",
                "inspector"
              ]
            }
          },
          "ownership": {
            "enum": [
              "none",
              "create_self",
              "self",
              "self_or_administrator"
            ]
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "roles",
          "ownership",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "roles",
    "default_deny",
    "actions"
  ],
  "additionalProperties": false
}
