{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-inspector.invalid/contracts/investigation-bundle-manifest.schema.json",
  "title": "Versioned investigation bundle integrity manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "const": "investigation.json"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
