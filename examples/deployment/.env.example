# No passwords here. Resolve a tested maintenance tag/digest before production release.
# 11.8 is the chosen supported baseline, not an immutable patch pin or a "latest" claim.
MARIADB_IMAGE=mariadb:11.8
# These images are outputs of the Codex build/release stages; not supplied in this package.
INSPECTOR_IMAGE=system-inspector:2.0.0
PROXY_IMAGE=caddy:2
# Safe initial bind; change explicitly to an approved LAN address for remote browser access.
INSPECTOR_BIND_ADDRESS=127.0.0.1
INSPECTOR_HTTPS_PORT=8443
INSPECTOR_UID=10001
INSPECTOR_GID=10001
