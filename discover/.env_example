# System Inspector server identity and SSH connection details
# Replace the example values with this host's actual details.
SERVER_ID="app-server-01"
SERVER_NAME="Application server 01"
SERVER_ADDRESS="192.0.2.20"
SERVER_PORT=22
SERVER_USER="logreader"
SUBSYSTEM_ID="s-core"

# Inspector parser. Verify this matches the timestamps and format in each log.
PARSER_ID="parser-iso-utc"
LOG_ENCODING="utf-8"

# Search host mount paths up to this depth; count includes mount directory.
MAX_LOG_DEPTH=4

# Semicolon-separated case-insensitive filename globs, e.g. "*.log;*.out".
LOG_FILE_PATTERNS="*.log"

# false = scan only Docker mounts likely to contain log files.
# true = scan all bind/volume mounts (slower, may find unrelated files).
SCAN_ALL_MOUNTS=false

# Relative output paths are resolved beside discover_docker_logs.sh.
OUTPUT_FILE="system-inspector-server.json"
